# Cache Python
__pycache__/
*.pyc

# Tests
.pytest_cache/

# Environnement virtuel
venv*/
.venv/

# Build PyInstaller
build/
dist/
*.spec
*.exe

# Données locales générées à l'exécution (pas de code, pas à versionner)
Cas/
profils/*.json
intellafeeder.ini

# Référentiel de types MIME : le fichier de DESCRIPTIONS appartient à Vound
# (livré avec Intella) et s'importe depuis l'installation locale — il n'a pas sa
# place dans un dépôt public. La liste des NOMS observés, elle, est versionnée :
# elle ne contient que des identifiants de types, et son obtention (cocher
# méthodiquement l'interface d'Intella) n'est pas reproductible par hasard.
mimetypes/*.properties

# Divers éditeurs / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Archives PyPak (embarquent intellafeeder.ini = donnees locales)
*.pypak
