# Cache Python
__pycache__/
*.pyc

# Tests
.pytest_cache/

# Environnement virtuel
venv*/
.venv/

# Build PyInstaller
build/
dist/
*.spec
*.exe

# Données locales générées à l'exécution (pas de code, pas à versionner)
Cas/
profils/*.json
intellafeeder.ini

# Référentiel de types MIME : le fichier de descriptions appartient à Vound
# (livré avec Intella) et s'importe depuis l'installation locale ; les noms
# observés viennent des cas de l'utilisateur. Ni l'un ni l'autre n'a sa place
# dans un dépôt public.
mimetypes/

# Divers éditeurs / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Archives PyPak (embarquent intellafeeder.ini = donnees locales)
*.pypak
